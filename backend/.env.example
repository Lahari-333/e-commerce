# Server Configuration
PORT=5000
HOST=0.0.0.0

# CORS Allowed Origin (e.g., https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration (Standard discrete parameters)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=shop_express
DB_PORT=3306

# Cloud Database SSL (Set to true for cloud providers like TiDB, Aiven, Railway)
DB_SSL=false

# Optional Cloud Database URI (Used by Railway / Render if connection string is provided)
# DATABASE_URL=mysql://user:password@host:port/shop_express

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
