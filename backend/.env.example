# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# CORS Allowed Origins (Set your deployed frontend URL here)
FRONTEND_URL=https://shop-express-jet.vercel.app
CLIENT_URL=https://shop-express-jet.vercel.app

# MySQL Database Configuration (For local MySQL or TiDB Cloud Serverless)
# TiDB Cloud Host format: gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=shop_express

# Cloud Database SSL (Auto-detected for TiDB Cloud port 4000 or set explicitly to true)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_LIMIT=10

# Optional Database Connection String (Alternative to discrete DB_* variables)
# DATABASE_URL=mysql://user:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/shop_express?ssl={"rejectUnauthorized":true}

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_32_character_string
JWT_EXPIRES_IN=7d
